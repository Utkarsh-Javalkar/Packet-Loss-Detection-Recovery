digraph G {
 graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.45", ranksep="0.75", fontname="DejaVu Sans", labelloc="t", label="Team 11 - Packet Loss Detection and Recovery Using UDP", fontsize=18];
 node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, color="#475569", penwidth=1.2, margin="0.16,0.10"];
 edge [fontname="DejaVu Sans", fontsize=9, color="#334155", penwidth=1.5, arrowsize=0.8];
 sender [label="UDP Sender\nh1\n10.0.0.1:5000", fillcolor="#DBEAFE"];
 receiver [label="UDP Receiver\nh2\n10.0.0.2:5001", fillcolor="#DCFCE7"];
 s1 [label="OVS s1\nports: 1=h1, 2=s2, 3=s3, 4=ctrl", fillcolor="#F1F5F9"];
 s2 [label="OVS s2\nports: 1=h2, 2=s1, 3=s3", fillcolor="#F1F5F9"];
 s3 [label="OVS s3\nports: 1=s1, 2=s2", fillcolor="#F1F5F9"];
 ctrlhost [label="Telemetry endpoint\nctrl-eth0\n10.0.0.254:6000", fillcolor="#FEF3C7"];
 osken [label="OS-Ken controller\nOpenFlow 1.3 / TCP 6653", fillcolor="#FCE7F3"];
 sender -> s1 [label="DATA / UDP"];
 s1 -> s2 [label="PRIMARY\ns1-eth2 <-> s2-eth2", dir=both, color="#2563EB", penwidth=2.5];
 s1 -> s3 [label="ALTERNATE\ns1-eth3 <-> s3-eth1", dir=both, color="#16A34A", penwidth=2.5];
 s3 -> s2 [label="ALTERNATE\ns3-eth2 <-> s2-eth3", dir=both, color="#16A34A", penwidth=2.5];
 s2 -> receiver [label="DATA / ACK / NACK", dir=both];
 receiver -> ctrlhost [label="TELEMETRY\nUDP", color="#D97706", style=dashed];
 ctrlhost -> osken [label="local UDP listener", color="#D97706", style=dashed];
 osken -> s1 [label="OpenFlow 1.3", color="#9333EA", style=dashed];
 osken -> s2 [label="OpenFlow 1.3", color="#9333EA", style=dashed];
 osken -> s3 [label="OpenFlow 1.3", color="#9333EA", style=dashed];
}